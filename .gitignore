# Local tooling — never committed. The first two patterns use single-character
# glob classes so this ignore file does not itself trip the forbidden-string
# audit while still matching the exact paths (see docs/CONVENTIONS.md).
[Cc]LAUDE.md
.[Cc]laude/
.remember/

# Scientific data — reproducible from fetchers, never committed
data/raw/**
data/reference/**
data/processed/**
data/external/*.nc
data/external/*.nc4
data/external/*.grib
data/external/*.h5
data/external/*.hdf5
data/external/*.zip
*.h5
*.hdf5
*.nc
*.grib

# Keep the directory guides and placeholders tracked even though the binary
# contents of these directories are ignored. See docs/CONVENTIONS.md,
# "Data discipline" and "Authorised deviations".
!data/raw/README.md
!data/reference/README.md
!data/processed/README.md
!data/raw/.gitkeep
!data/reference/.gitkeep
!data/processed/.gitkeep

# Operator-supplied third-party material — copyrighted, never committed, per the
# third-party-text rule in docs/CONVENTIONS.md. Only the tracked README.md in
# each location records what belongs there. Keeping these ignored also makes the
# `git add -A` in scripts/autocommit.sh safe: it can never sweep a copyrighted
# PDF or the Springer Nature class files into a data commit.
docs/literature/*.pdf
manuscript/template/**
!manuscript/template/README.md

# Environments
.conda/
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# LaTeX
*.aux
*.log
*.out
*.toc
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.bcf
*.run.xml

# OS
.DS_Store
Thumbs.db

# Logs and scratch
logs/**/*.log
*.tmp
scratch/
